# Copy to .env.local — never commit real values.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Cloudflare Turnstile captcha on the auth screens.
# Leave unset to disable the captcha entirely (useful for local dev, tests and CI).
# This is the PUBLIC sitekey — the matching secret belongs only in the Supabase dashboard
# (Authentication → Attack Protection), never in this file or the bundle.
# IMPORTANT: set this and deploy BEFORE enabling captcha in Supabase, or auth will start
# rejecting every request that has no token.
VITE_TURNSTILE_SITEKEY=
